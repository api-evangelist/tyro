      "info": {
        "name": "Pay Refunds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Refunds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tyro.com/connect/pay/refunds",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ]
          },
          "docs": "Returns a list of refunds."
        },
        {
          "info": {
            "name": "Create a Refund Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tyro.com/connect/pay/refunds",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint is used to create a Refund Request.\n\nRefunds can only be created for successful payments made via a Pay Request. If a Pay Request has not yet been captured, then void the Pay Request instead.\n\nRefunds can be made for the total or partial amount of the Pay Request. Multiple refunds can be created for the same Pay Request as long as the total refunds amount does not exceed the original Pay Request total.\n\nRefunds can only be sent back to the original payment method used."
        },
        {
          "info": {
            "name": "Retrieve a Refund Request",
