      "items": [
        {
          "info": {
            "name": "Create a Pay Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tyro.com/connect/pay/requests",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint is used for creating a Pay Request. Your server should create a Pay Request as soon as the total payment amount is known. Once the Pay Request is created, your frontend will use Tyro.js to collect the customer's payment details and invoke submit() to execute the payment."
        },
        {
          "info": {
            "name": "Retrieve a Pay Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tyro.com/connect/pay/requests/:payRequestId",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "payRequestId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint is for fetching Pay Requests."
        },
        {
          "info": {
            "name": "Update or execute actions on the Pay Request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.tyro.com/connect/pay/requests/:payRequestId",
